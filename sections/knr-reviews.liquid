{%- comment -%}
  KNR Customer Reviews Section
{%- endcomment -%}

<section class="knr-reviews knr-width--{{ section.settings.content_width | default: 'wide' }}" style="--knr-pt: {{ section.settings.padding_top | default: 0 }}px; --knr-pb: {{ section.settings.padding_bottom | default: 120 }}px; --knr-pt-m: {{ section.settings.padding_top_mobile | default: 40 }}px; --knr-pb-m: {{ section.settings.padding_bottom_mobile | default: 64 }}px;" id="reviews">
  <div class="knr-reviews__container">
    <div class="knr-reviews__header">
      <h2 class="knr-section-heading">{{ section.settings.title | default: "Avis clients" }}</h2>
    </div>

    <div class="knr-reviews__summary">
      <div class="knr-reviews__score-wrap">
        <div class="knr-reviews__score-row">
          <div class="knr-stars">
            {%- for i in (1..5) -%}
              <img src="{{ 'star-icon0.svg' | asset_url }}" alt="" width="12" height="12">
            {%- endfor -%}
          </div>
          <span class="knr-reviews__big-score">{{ section.settings.overall_score | default: "4.7 sur 5" }}</span>
        </div>
        <span class="knr-reviews__total-count">Basé sur {{ section.settings.total_count | default: "200 avis" }}</span>
      </div>

      <div class="knr-reviews__bars">
        {%- assign bar_counts = section.settings.bar_counts | default: '32,10,5,6,1' | split: ',' -%}
        {%- assign bar_max = 0 -%}
        {%- for c in bar_counts -%}
          {%- assign cn = c | plus: 0 -%}
          {%- if cn > bar_max -%}{%- assign bar_max = cn -%}{%- endif -%}
        {%- endfor -%}
        {%- if bar_max == 0 -%}{%- assign bar_max = 1 -%}{%- endif -%}

        {%- for level in (1..5) -%}
          {%- assign idx = 5 | minus: level -%}
          {%- assign filled = 5 | minus: idx -%}
          {%- assign count = bar_counts[idx] | plus: 0 -%}
          {%- assign pct = count | times: 100 | divided_by: bar_max -%}
          <div class="knr-review-bar-row">
            <div class="knr-stars">
              {%- for i in (1..5) -%}
                {%- if forloop.index <= filled -%}
                  <img src="{{ 'star-icon0.svg' | asset_url }}" alt="" width="12" height="12">
                {%- else -%}
                  <img src="{{ 'star-icon24.svg' | asset_url }}" alt="" width="12" height="12">
                {%- endif -%}
              {%- endfor -%}
            </div>
            <div class="knr-review-bar-track">
              <div class="knr-review-bar-fill" style="width: {{ pct }}%;"></div>
            </div>
            <span class="knr-review-bar-row__count">{{ count }}</span>
          </div>
        {%- endfor -%}
      </div>

      <div class="knr-reviews__actions">
        <button type="button" class="knr-reviews__btn knr-reviews__btn--dark">Écrire un avis</button>
        <button type="button" class="knr-reviews__btn knr-reviews__btn--light">Poser une question</button>
      </div>
    </div>

    <div class="knr-reviews__list">
      <button type="button" class="knr-reviews__filter">
        <img src="{{ 'filter-lines0.svg' | asset_url }}" alt="" width="18" height="18">
        <span>Filtrer</span>
      </button>

      {%- for block in section.blocks -%}
        <div class="knr-review-card" {{ block.shopify_attributes }}>
          <div class="knr-review-card__header">
            <div class="knr-stars">
              {%- for i in (1..5) -%}
                <img src="{{ 'star-icon0.svg' | asset_url }}" alt="" width="12" height="12">
              {%- endfor -%}
            </div>
            <span class="knr-review-card__date">{{ block.settings.date | default: "09/02/26" }}</span>
          </div>

          <div class="knr-review-card__author-row">
            <span class="knr-review-card__author">{{ block.settings.author }}</span>
            {%- if block.settings.verified -%}
              <span class="knr-review-card__verified">Vérifié</span>
            {%- endif -%}
          </div>

          <div class="knr-review-card__content-wrap">
            {%- if block.settings.subtitle != blank -%}
              <div class="knr-review-card__subtitle">{{ block.settings.subtitle }}</div>
            {%- endif -%}
            <div class="knr-review-card__content">{{ block.settings.content }}</div>
          </div>
        </div>
      {%- endfor -%}
    </div>

    <div class="knr-reviews__more-wrap">
      <button type="button" class="knr-reviews__more-btn">Charger plus</button>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "KNR Avis clients",
  "settings": [
    {
      "type": "header",
      "content": "Espacement (marges intérieures)"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Marge haute — bureau",
      "min": 0, "max": 200, "step": 4, "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Marge basse — bureau",
      "min": 0, "max": 200, "step": 4, "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Marge haute — mobile",
      "min": 0, "max": 160, "step": 4, "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Marge basse — mobile",
      "min": 0, "max": 160, "step": 4, "unit": "px",
      "default": 64
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Largeur du contenu",
      "options": [
        { "value": "full", "label": "Pleine largeur" },
        { "value": "wide", "label": "Large" },
        { "value": "box", "label": "Boîte" }
      ],
      "default": "wide"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Avis clients"
    },
    {
      "type": "text",
      "id": "overall_score",
      "label": "Note globale",
      "default": "4.7 sur 5"
    },
    {
      "type": "text",
      "id": "bar_counts",
      "label": "Répartition des notes (5,4,3,2,1)",
      "info": "Nombre d'avis par niveau, séparés par des virgules.",
      "default": "32,10,5,6,1"
    },
    {
      "type": "text",
      "id": "total_count",
      "label": "Nombre total d'avis",
      "default": "200 avis"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Avis client",
      "settings": [
        { "type": "text", "id": "author", "label": "Auteur", "default": "Mathilde S" },
        { "type": "text", "id": "date", "label": "Date", "default": "09/02/26" },
        { "type": "checkbox", "id": "verified", "label": "Client vérifié", "default": true },
        { "type": "text", "id": "subtitle", "label": "Sous-titre / Durée", "default": "Après usage d’1 mois" },
        { "type": "textarea", "id": "content", "label": "Commentaire", "default": "Maison Célestine est une marque de soins anti-âge haut de gamme formulée autour d’actifs rares et certifiés biologiques, guidée par une expertise médicale et un rituel simple, précis et efficace." }
      ]
    }
  ],
  "presets": [
    {
      "name": "KNR Avis clients",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "author": "Mathilde S",
            "subtitle": "Après usage d’1 mois"
          }
        },
        {
          "type": "review",
          "settings": {
            "author": "Clara T.",
            "subtitle": "Après usage de 3 mois",
            "content": "J'utilise ce sérum depuis trois mois et la différence est saisissante. Mes rides d'expression se sont considérablement atténuées et mon teint a retrouvé sa luminosité."
          }
        },
        {
          "type": "review",
          "settings": {
            "author": "Sophie M.",
            "subtitle": "Après usage de 2 mois",
            "content": "Fusionnant l'huile de rosier muscat et l'extrait de cactus, notre peau retrouve fermeté et vitalité naturelle."
          }
        }
      ]
    }
  ]
}
{% endschema %}
