{%- comment -%}
  KNR Engagement / Brand Manifesto Section
{%- endcomment -%}

{%- assign main_variant = product.selected_or_first_available_variant -%}

{%- assign bg_src = section.settings.bg_image_url | default: 'https://cdn.shopify.com/s/files/1/0746/5520/3505/files/image0.png?v=1790000599' -%}
{%- if section.settings.bg_image != blank -%}
  {%- assign bg_src = section.settings.bg_image | image_url: width: 2000 -%}
{%- endif -%}

<section class="knr-engagement knr-width--{{ section.settings.content_width | default: 'wide' }}" style="--knr-pt: {{ section.settings.padding_top | default: 80 }}px; --knr-pb: {{ section.settings.padding_bottom | default: 0 }}px; --knr-pt-m: {{ section.settings.padding_top_mobile | default: 0 }}px; --knr-pb-m: {{ section.settings.padding_bottom_mobile | default: 0 }}px;">
  <div class="knr-engagement__container">
  <div class="knr-engagement__media" style="background-image: url('{{ bg_src }}');">
    <div class="knr-engagement__overlay"></div>

    <div class="knr-engagement__content">
      <div class="knr-engagement__intro">
        <h2 class="knr-engagement__title">{{ section.settings.title | default: "Notre engagement pour une beauté régénérée" }}</h2>
        <div class="knr-engagement__divider"></div>
      </div>

      <div class="knr-engagement__manifesto">
        <div class="knr-engagement__quote">
          {{ section.settings.quote | default: "Fusionnant l'huile de rosier muscat, le rétinol végétal et l'extrait de cactus, notre sérum pénètre en profondeur pour stimuler le renouvellement cellulaire, atténuer les rides et redonner à la peau son éclat et sa fermeté naturels." }}
        </div>
        <div class="knr-engagement__author">{{ section.settings.author | default: "Sophie M." }}</div>
      </div>
    </div>
  </div>

  {%- if section.settings.show_quick_buy -%}
    <div class="knr-quick-buy-card">
      <div class="knr-quick-buy-card__row">
        {%- if product.featured_image != blank -%}
          <img src="{{ product.featured_image | image_url: width: 208 }}" alt="{{ product.title }}" class="knr-quick-buy-card__thumb" width="104" height="104" loading="lazy">
        {%- else -%}
          <img src="https://cdn.shopify.com/s/files/1/0746/5520/3505/files/product-info6.png?v=1789999070" alt="{{ product.title }}" class="knr-quick-buy-card__thumb" width="104" height="104" loading="lazy">
        {%- endif -%}

        <div class="knr-quick-buy-card__info">
          <div class="knr-quick-buy-card__details">
            <span class="knr-quick-buy-card__title">{{ product.title | default: "Sérum Précieux Régénérant" }}</span>
            {%- if product.variants.size > 0 -%}
              <div class="knr-quick-buy-card__variants">
                {%- for variant in product.variants -%}
                  <button
                    type="button"
                    class="knr-variant-btn{% if variant.id == main_variant.id %} is-active{% endif %}{% unless variant.available %} is-unavailable{% endunless %}"
                    data-variant-id="{{ variant.id }}"
                    data-price="{{ variant.price | money }}"
                    data-available="{{ variant.available }}"
                  >{{ variant.title }}</button>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>
          <span class="knr-quick-buy-card__price">{{ main_variant.price | money }}</span>
        </div>
      </div>

      <form method="post" action="{{ routes.cart_add_url }}" class="knr-quick-buy-card__form">
        <input type="hidden" name="id" value="{{ main_variant.id }}" data-quick-buy-id>
        <input type="hidden" name="quantity" value="1">
        <input type="hidden" name="return_to" value="back">
        <button
          type="submit"
          class="knr-atc-btn"
          data-available-text="Ajouter au panier"
          data-sold-out-text="Rupture de stock"
          {% unless main_variant.available %}disabled{% endunless %}
        >
          {% if main_variant.available %}Ajouter au panier{% else %}Rupture de stock{% endif %}
        </button>
      </form>
    </div>
  {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "KNR Engagement",
  "settings": [
    {
      "type": "header",
      "content": "Espacement (marges intérieures)"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Marge haute — bureau",
      "min": 0, "max": 200, "step": 4, "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Marge basse — bureau",
      "min": 0, "max": 200, "step": 4, "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Marge haute — mobile",
      "min": 0, "max": 160, "step": 4, "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Marge basse — mobile",
      "min": 0, "max": 160, "step": 4, "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Largeur du contenu",
      "options": [
        { "value": "full", "label": "Pleine largeur" },
        { "value": "wide", "label": "Large" },
        { "value": "box", "label": "Boîte" }
      ],
      "default": "wide"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Notre engagement pour une beauté régénérée"
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Texte du manifeste",
      "default": "Fusionnant l'huile de rosier muscat, le rétinol végétal et l'extrait de cactus, notre sérum pénètre en profondeur pour stimuler le renouvellement cellulaire, atténuer les rides et redonner à la peau son éclat et sa fermeté naturels."
    },
    {
      "type": "text",
      "id": "author",
      "label": "Auteur",
      "default": "Sophie M."
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Image de fond"
    },
    {
      "type": "checkbox",
      "id": "show_quick_buy",
      "label": "Afficher la carte d'achat rapide",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "KNR Engagement"
    }
  ]
}
{% endschema %}
